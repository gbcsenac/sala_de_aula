# .env.exemplo — o modelo do .env.
#
# Copie este arquivo, renomeie a cópia para .env e troque a senha.
# O .env fica fora do repositório (.gitignore): a senha de cada máquina é só dela.

PG_HOST=localhost
PG_PORTA=5432
PG_USUARIO=postgres
PG_SENHA=troque-aqui

# o banco de verdade, que a janela usa
PG_BANCO=locadora
# o que os testes apagam à vontade — NUNCA o mesmo de cima
PG_BANCO_DE_TESTE=locadora_teste
